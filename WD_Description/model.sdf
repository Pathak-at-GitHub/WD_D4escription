    <!-- Rigid connections (mates: coincident + concentric with rotation locked) -->
    <joint name="body4_to_body3_1" type="fixed"><parent>body4</parent><child>body3_1</child></joint>
    <joint name="body4_to_body3_2" type="fixed"><parent>body4</parent><child>body3_2</child></joint>
    <joint name="body3_1_to_motor_1" type="fixed"><parent>body3_1</parent><child>motor_1</child></joint>
    <joint name="body3_1_to_motor_2" type="fixed"><parent>body3_1</parent><child>motor_2</child></joint>
    <joint name="body3_2_to_motor_3" type="fixed"><parent>body3_2</parent><child>motor_3</child></joint>
    <joint name="body3_2_to_motor_4" type="fixed"><parent>body3_2</parent><child>motor_4</child></joint>

    <!-- Rotors: concentric mate without rotation lock -> free revolute about the shared axis (child-frame Y) -->
    <joint name="rotor_1_joint" type="revolute">
      <parent>motor_1</parent><child>blade_1</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>1e-6</damping></dynamics></axis>
    </joint>
    <joint name="rotor_2_joint" type="revolute">
      <parent>motor_2</parent><child>blade_2</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>1e-6</damping></dynamics></axis>
    </joint>
    <joint name="rotor_3_joint" type="revolute">
      <parent>motor_3</parent><child>blade_3</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>1e-6</damping></dynamics></axis>
    </joint>
    <joint name="rotor_4_joint" type="revolute">
      <parent>motor_4</parent><child>blade_4</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>1e-6</damping></dynamics></axis>
    </joint>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_1_joint</joint_name><topic>/wd/rotor_1/cmd_vel</topic><use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_2_joint</joint_name><topic>/wd/rotor_2/cmd_vel</topic><use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_3_joint</joint_name><topic>/wd/rotor_3/cmd_vel</topic><use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_4_joint</joint_name><topic>/wd/rotor_4/cmd_vel</topic><use_force_commands>false</use_force_commands>
    </plugin>
  </model>
</sdf>
